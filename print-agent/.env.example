# نفس بيانات مشروع Supabase المستخدمة بباقي التطبيقات
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# معرّف فريد لهذا الجهاز — لازم يطابق بالضبط المعرّف اللي يدخله الكاشير
# بصفحة "إعدادات الطباعة" بنظام الكاشير على نفس الجهاز فعلياً. لو عندك
# أكثر من جهاز كاشير، كل واحد ياخذ معرّف مختلف (مثلاً cashier-1, cashier-2).
STATION_ID=

# طابعة فعلية واحدة فقط لكل جهاز كاشير — تطبع فاتورة المطبخ المختصرة ثم
# فاتورة العميل الكاملة بالتفاصيل تباعاً على نفس الجهاز (كل واحدة تُقص
# لوحدها). عنوانها يُضبط الآن من نظام الكاشير (صفحة إعدادات الطباعة، لهذا
# الجهاز/STATION_ID تحديداً) ويُقرأ تلقائياً كل 15 ثانية — لا تحتاج ضبطه هنا
# عادة. المتغير التالي احتياطي فقط، يُستخدم إلى حين أول قراءة ناجحة من
# قاعدة البيانات أو لو تُرك فارغاً هناك.
# على لينكس عادة عبر تعريف usblp:
#   PRINTER_INTERFACE=printer:/dev/usb/lp0
# أو طابعة شبكية:
#   PRINTER_INTERFACE=tcp://192.168.1.50:9100
PRINTER_INTERFACE=
