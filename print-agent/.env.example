# نفس بيانات مشروع Supabase المستخدمة بباقي التطبيقات
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# معرّف فريد لهذا الجهاز — لازم يطابق بالضبط المعرّف اللي يدخله الكاشير
# بصفحة "إعدادات الطباعة" بنظام الكاشير على نفس الجهاز فعلياً. لو عندك
# أكثر من جهاز كاشير، كل واحد ياخذ معرّف مختلف (مثلاً cashier-1, cashier-2).
STATION_ID=

# عناوين الطابعتين تُضبطان الآن من نظام الكاشير (صفحة إعدادات الطباعة، لهذا
# الجهاز/STATION_ID تحديداً) وتُقرآن تلقائياً كل 15 ثانية — لا تحتاج ضبطها
# هنا عادة. المتغيرات التالية احتياطية فقط، تُستخدم إلى حين أول قراءة ناجحة
# من قاعدة البيانات أو لو تُركت فارغة هناك.
# على لينكس عادة عبر تعريف usblp:
#   KITCHEN_PRINTER_INTERFACE=printer:/dev/usb/lp0
#   CUSTOMER_PRINTER_INTERFACE=printer:/dev/usb/lp1
# أو طابعة شبكية:
#   CUSTOMER_PRINTER_INTERFACE=tcp://192.168.1.50:9100
KITCHEN_PRINTER_INTERFACE=
CUSTOMER_PRINTER_INTERFACE=
