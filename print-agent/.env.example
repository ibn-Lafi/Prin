# نفس بيانات مشروع Supabase المستخدمة بباقي التطبيقات
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# عناوين الطابعتين تُضبط الآن من لوحة الإدارة (الإعدادات العامة) وتُقرأ تلقائياً
# كل 15 ثانية — لا تحتاج ضبطها هنا عادة. المتغيرات التالية احتياطية فقط،
# تُستخدم إلى حين أول قراءة ناجحة من قاعدة البيانات أو لو تُركت فارغة هناك.
# على لينكس عادة عبر تعريف usblp:
#   KITCHEN_PRINTER_INTERFACE=printer:/dev/usb/lp0
#   CUSTOMER_PRINTER_INTERFACE=printer:/dev/usb/lp1
# أو طابعة شبكية:
#   CUSTOMER_PRINTER_INTERFACE=tcp://192.168.1.50:9100
KITCHEN_PRINTER_INTERFACE=
CUSTOMER_PRINTER_INTERFACE=
