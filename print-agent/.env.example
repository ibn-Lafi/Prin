# نفس بيانات مشروع Supabase المستخدمة بباقي التطبيقات
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# واجهة كل طابعة حرارية USB — على لينكس عادة عبر تعريف usblp:
#   KITCHEN_PRINTER_INTERFACE=printer:/dev/usb/lp0
#   CUSTOMER_PRINTER_INTERFACE=printer:/dev/usb/lp1
# أو طابعة شبكية:
#   CUSTOMER_PRINTER_INTERFACE=tcp://192.168.1.50:9100
KITCHEN_PRINTER_INTERFACE=
CUSTOMER_PRINTER_INTERFACE=
